# Copy this file to `.env` and adjust values for your environment.
# `.env` is read both by docker-compose.yml (container wiring) and by the
# notebooks via python-dotenv (so MONGO_HOST, KAFKA_HOST, etc. don't need to
# be hand-edited per machine anymore).

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
DB_NAME=fit3182_db

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_HOST=kafka
KAFKA_PORT=9092
TOPIC_A=camera-events-A
TOPIC_B=camera-events-B
TOPIC_C=camera-events-C

# ── Data directory (container-internal path; bind-mounted from ./data) ───
DATA_DIR=/home/student/work/data


# ── Streaming parameters ──────────────────────────────────────────────────
WATERMARK_DELAY=30 minutes
JOIN_WINDOW=45 seconds
JOIN_WINDOW_SECONDS=45

# ── Producer batch cadence (seconds between batches) ─────────────────────
BATCH_SLEEP_A=5.0
BATCH_SLEEP_B=0.470779
BATCH_SLEEP_C=0.335227

# ── Host port mappings ────────────────────────────────────────────────────
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
MONGO_EXPOSED_PORT=27017
KAFKA_EXPOSED_PORT=9092

# ── Jupyter access token ──────────────────────────────────────────────────
# Fixed token used to log in to Jupyter (appended as ?token=... to the URL,
# or pasted into the login page). Using a fixed value here — rather than
# Jupyter's auto-generated random token or its "set a password" UI — means
# you don't have to re-authenticate every time the container is rebuilt or
# recreated (the password hash lives in the container's writable layer and
# is lost on `docker compose down`/rebuild; this env var is not).
# CHANGE THIS to your own secret value, especially before exposing the
# Jupyter port publicly (e.g. on an Oracle Cloud instance).
JUPYTER_TOKEN=0bec4c3fd4c4f0b7fa9bfeeb5a7124368738ad1c97ba7d8f
